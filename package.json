{
  "name": "zoom-breakout-rooms",
  "version": "1.0.0",
  "description": "A simple Recall.ai sample for Zoom main-room and specific-room bots",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "mkdir -p data && drizzle-kit migrate",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "biome lint . --error-on-warnings",
    "format": "biome check --write .",
    "format:check": "biome check . --error-on-warnings"
  },
  "author": "Ben Reilly",
  "license": "MIT",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@libsql/client": "^0.18.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.58.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.6.3"
  },
  "type": "module"
}
